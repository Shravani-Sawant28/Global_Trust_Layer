# ─── Server ─────────────────────────────────────────────────
PORT=3001

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/gtl_db

# Set to 'require' to enable SSL (needed for cloud-hosted DBs like Supabase, Railway, Neon)
# PGSSLMODE=require

# ─── Blockchain ──────────────────────────────────────────────
# Arbitrum Sepolia RPC endpoint
# Use a private Alchemy/Infura endpoint in production
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Contract addresses — update after deploying with:
# npx hardhat run scripts/deploy.js --network arbitrumSepolia
ESCROW_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ─── AI ──────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=

# ─── CORS ────────────────────────────────────────────────────
# Frontend URL (default: http://localhost:3000 for Next.js dev)
FRONTEND_URL=http://localhost:3000
